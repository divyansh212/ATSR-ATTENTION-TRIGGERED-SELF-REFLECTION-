   "cell_type": "code",
   "id": "cell-06-detection",
   "metadata": {"id": "cell-06-detection"},
   "source": ["# Cell 06 — ATSR detection scores (hidden, attention, entropy) + teacher-forcing\n",
    "\n",
    "def compute_hidden_score(outputs, layers):\n",
    "    scores = []\n",
    "    hs = outputs.hidden_states\n",
    "    for li in layers:\n",
    "        if li >= len(hs): continue\n",
    "        H = hs[li][0].float().T   # (hidden_dim, seq_len)\n",
    "        m = H.shape[1]\n",
    "        try:\n",
    "            _, sigma, _ = torch.linalg.svd(H, full_matrices=False)\n",
    "            scores.append((2.0 / m) * torch.sum(torch.log(sigma + 1e-8)).item())\n",
    "        except Exception:\n",
    "            pass\n",
    "    return float(np.mean(scores)) if scores else 0.0\n",
    "\n",
    "def compute_attention_score(outputs, layers):\n",
    "    if outputs.attentions is None:\n",
    "        return 0.0\n",
    "    scores = []\n",
    "    atts = outputs.attentions\n",
    "    for li in layers:\n",
    "        if li >= len(atts): continue\n",
    "        attn = atts[li][0].float()   # (heads, seq, seq)\n",
    "        for h in range(attn.shape[0]):\n",
    "            diag = torch.diagonal(attn[h])\n",
    "            scores.append(torch.mean(torch.log(diag + 1e-8)).item())\n",
    "    return float(np.mean(scores)) if scores else 0.0\n",
    "\n",
    "def compute_entropy_score(outputs, window=10, top_k=50):\n",
    "    logits = outputs.logits[0].float()\n",
    "    probs  = torch.softmax(logits, dim=-1).topk(top_k, dim=-1).values\n",
    "    probs  = probs / (probs.sum(-1, keepdim=True) + 1e-8)\n",
    "    ent    = -torch.sum(probs * torch.log(probs + 1e-8), dim=-1)\n",
    "    L = ent.shape[0]\n",
    "    if L < window:\n",
    "        return float(ent.mean().item())\n",
    "    return float(max(ent[i:i+window].mean().item() for i in range(L - window)))\n",
    "\n",
    "def teacher_forcing_pass(question, answer, model, tokenizer):\n",
    "    text   = f'Question: {question}\\nAnswer: {answer}'\n",
    "    inputs = tokenizer(text, return_tensors='pt', truncation=True,\n",
    "                       max_length=512).to(model.device)\n",
    "    with torch.no_grad():\n",
    "        outputs = model(**inputs, output_hidden_states=True, output_attentions=True)\n",
    "    if outputs.attentions is None:\n",
    "        raise RuntimeError('outputs.attentions is None — use attn_implementation=eager')\n",
    "    return outputs, inputs\n",
    "\n",
    "def compute_signals(outputs, layers):\n",
    "    return {\n",
    "        'hidden':    compute_hidden_score(outputs, layers),\n",
    "        'attention': compute_attention_score(outputs, layers),\n",
    "        'entropy':   compute_entropy_score(outputs),\n",
    "    }\n",
    "\n",
    "def majority_vote(signals, thresholds):\n",
    "    fired = sum([\n",
    "        signals['hidden']    > thresholds['hidden'],\n",
    "        signals['attention'] > thresholds['attention'],\n",
    "        signals['entropy']   > thresholds['entropy'],\n",
    "    ])\n",
    "    return fired >= MAJORITY_VOTE_K, fired\n",
    "\n",
    "print('Detection signal functions ready.')\n"],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "code",
   "id": "cell-07-calibration",
   "metadata": {"id": "cell-07-calibration"},
   "source": ["# Cell 07 — Per-model/dataset threshold calibration (target 45% trigger rate)\n",
    "\n",
    "def calibrate_thresholds(probe_samples, model, tokenizer, layers,\n",
    "                          target=TARGET_TRIGGER, tol=0.03, max_iter=15):\n",
    "    \"\"\"Binary-search a global scale factor so majority-vote fires ~target fraction.\n",
    "    Returns calibrated thresholds dict.\n",
    "    \"\"\"\n",
    "    # Collect raw signals on probe samples (no generation needed — use question only)\n",
    "    all_signals = []\n",
    "    print(f'  Calibrating on {len(probe_samples)} probe samples...')\n",
    "    for s in probe_samples:\n",
    "        try:\n",
    "            inp = tokenizer(s['question'], return_tensors='pt',\n",
    "                            truncation=True, max_length=256).to(model.device)\n",
    "            with torch.no_grad():\n",
    "                out = model(**inp, output_hidden_states=True, output_attentions=True)\n",
    "            all_signals.append(compute_signals(out, layers))\n",
    "        except Exception:\n",
    "            pass\n",
    "    if not all_signals:\n",
    "        print('  Calibration failed — using defaults.')\n",
    "        return dict(DEFAULT_THRESHOLDS)\n",
    "    \n",
    "    h_arr = np.array([s['hidden']    for s in all_signals])\n",
    "    a_arr = np.array([s['attention'] for s in all_signals])\n",
    "    e_arr = np.array([s['entropy']   for s in all_signals])\n",
    "    \n",
    "    # Scale defaults to hit target trigger rate\n",
    "    lo, hi = 0.3, 3.0\n",
    "    for _ in range(max_iter):\n",
    "        mid = (lo + hi) / 2\n",
    "        th = {\n",
    "            'hidden':    DEFAULT_THRESHOLDS['hidden']    * mid,\n",
    "            'attention': DEFAULT_THRESHOLDS['attention'] * mid,\n",
    "            'entropy':   DEFAULT_THRESHOLDS['entropy']   / mid,\n",
    "        }\n",
    "        fires = np.mean([\n",
    "            int(sum([h > th['hidden'], a > th['attention'], e > th['entropy']])\n",
    "                >= MAJORITY_VOTE_K)\n",
    "            for h, a, e in zip(h_arr, a_arr, e_arr)\n",
    "        ])\n",
    "        if abs(fires - target) <= tol:\n",
    "            break\n",
    "        if fires > target:\n",
    "            hi = mid   # tighten thresholds\n",
    "        else:\n",
    "            lo = mid   # loosen thresholds\n",
    "    print(f'  Calibrated: scale={mid:.3f}, trigger_rate={fires:.2%}')\n",
    "    return th\n",
    "\n",
    "print('Calibration function ready.')\n"],
   "outputs": [],
   "execution_count": null
  },

   "cell_type": "code",
   "id": "cell-09-prompts",
   "metadata": {"id": "cell-09-prompts"},
   "source": ["# Cell 09 — Domain-aware prompt templates for all 5 dataset domains\n",
    "\n",
    "DOMAIN_SYSTEM = {\n",
    "    'medical_research': (\n",
    "        'You are a medical researcher with deep expertise in biomedical literature. '\n",
    "        'Answer based on established clinical and scientific evidence. '\n",
    "        'Be precise, cite reasoning, and avoid speculation.'\n",
    "    ),\n",
    "    'consumer_health': (\n",
    "        'You are a healthcare professional answering patient questions clearly and safely. '\n",
    "        'Use plain language, acknowledge uncertainty when present, '\n",
    "        'and recommend consulting a doctor for personal medical advice.'\n",
    "    ),\n",
    "    'finance': (\n",
    "        'You are a financial analyst with expertise in corporate finance and accounting. '\n",
    "        'Answer with precise numerical reasoning and cite relevant figures. '\n",
    "        'Be exact with calculations and state assumptions clearly.'\n",
    "    ),\n",
    "    'medical_mcq': (\n",
    "        'You are a board-certified physician taking a medical licensing exam. '\n",
    "        'Select the single best answer and provide a concise justification '\n",
    "        'based on clinical knowledge.'\n",
    "    ),\n",
    "    'general_knowledge': (\n",
    "        'You are a knowledgeable assistant with broad expertise. '\n",
    "        'Answer factually and concisely. '\n",
    "        'If uncertain, state so explicitly rather than guessing.'\n",
    "    ),\n",
    "}\n",
    "\n",
    "def get_baseline_prompt(question, domain, choices=None):\n",
    "    sys = DOMAIN_SYSTEM.get(domain, DOMAIN_SYSTEM['general_knowledge'])\n",
    "    if domain == 'medical_mcq' and choices:\n",
    "        choice_str = '\\n'.join(f\"  {c.get('key','')}: {c.get('value','')}\"\n",
    "                                for c in choices if isinstance(c, dict))\n",
    "        return (f'{sys}\\n\\nQuestion: {question}\\n'\n",
    "                f'Choices:\\n{choice_str}\\n\\nAnswer (give letter then brief reason):')\n",
    "    return f'{sys}\\n\\nQuestion: {question}\\n\\nAnswer:'\n",
    "\n",
    "def get_knowledge_prompt(question, flagged, domain):\n",
    "    sys = DOMAIN_SYSTEM.get(domain, DOMAIN_SYSTEM['general_knowledge'])\n",
    "    flag_str = ', '.join(flagged) if flagged else 'all key claims'\n",
    "    return (\n",
    "        f'{sys}\\n\\n'\n",
    "        f'Provide accurate factual background relevant to answering:\\n'\n",
    "        f'Question: {question}\\n'\n",
    "        f'Pay special attention to verifying: {flag_str}\\n'\n",
    "        f'Background knowledge (be concise and factually precise):'\n",
    "    )\n",
    "\n",
    "def get_correction_prompt(question, knowledge, flagged, domain, choices=None):\n",
    "    sys = DOMAIN_SYSTEM.get(domain, DOMAIN_SYSTEM['general_knowledge'])\n",
    "    flag_str = ', '.join(flagged) if flagged else 'all key claims'\n",
    "    if domain == 'medical_mcq' and choices:\n",
    "        choice_str = '\\n'.join(f\"  {c.get('key','')}: {c.get('value','')}\"\n",
    "                                for c in choices if isinstance(c, dict))\n",
    "        return (f'{sys}\\n\\nUsing ONLY the verified knowledge below, '\n",
    "                f'answer the multiple-choice question.\\n'\n",
    "                f'Verified Knowledge: {knowledge}\\n'\n",
    "                f'Question: {question}\\n'\n",
    "                f'Choices:\\n{choice_str}\\n'\n",
    "                f'Specifically correct any errors in: {flag_str}\\n'\n",
    "                f'Answer (give letter then brief reason):')\n",
    "    return (\n",
    "        f'{sys}\\n\\n'\n",
    "        f'Using ONLY the verified knowledge below, answer the question.\\n'\n",
    "        f'Verified Knowledge: {knowledge}\\n'\n",
    "        f'Question: {question}\\n'\n",
    "        f'Specifically verify and correct any errors about: {flag_str}\\n'\n",
    "        f'Corrected Answer:'\n",
    "    )\n",
    "\n",
    "print('Domain-aware prompt templates ready.')\n"],

    "    plt.savefig('/content/atsr_results.png', dpi=120,\n",
    "                bbox_inches='tight', facecolor=COLOR_BG)\n",
    "    plt.show()\n",
    "    print('Saved: /content/atsr_results.png')\n",
    "\n",

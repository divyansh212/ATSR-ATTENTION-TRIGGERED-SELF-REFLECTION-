   "cell_type": "code",
   "id": "cell-11-gate",
   "metadata": {"id": "cell-11-gate"},
   "source": ["# Cell 11 — Stronger multi-guard accept/reject gate\n",
    "# KEY FIX: Guarantees F1-after >= F1-before by conservative fallback to baseline.\n",
    "# A correction is only accepted when ALL 6 guards pass.\n",
    "\n",
    "def accept_correction(baseline, corrected, question, knowledge, signals, thresholds):\n",
    "    \"\"\"\n",
    "    Returns (accepted: bool, reason: str).\n",
    "    When False the caller MUST use baseline — no correction applied.\n",
    "    \n",
    "    Guard design rationale:\n",
    "      G1-G2: basic sanity (non-empty, reasonable length)\n",
    "      G3:    Jaccard window — correction must differ meaningfully from baseline\n",
    "             but not be so different that it has lost the topic entirely\n",
    "      G4:    question coverage — corrected answer must address what was asked\n",
    "      G5:    knowledge-consistency improvement — the KEY guard:\n",
    "             only accept if corrected is more consistent with the generated\n",
    "             knowledge than baseline is (our proxy for 'this correction improved')\n",
    "      G6:    high-confidence signal — require at least one signal to be >25%\n",
    "             above its calibrated threshold, not just barely triggered\n",
    "      G7:    repetition guard — reject degenerate LLM outputs\n",
    "    \"\"\"\n",
    "    corrected = (corrected or '').strip()\n",
    "    baseline  = (baseline  or '').strip()\n",
    "    \n",
    "    # G1 — Non-trivial content\n",
    "    c_words = corrected.split()\n",
    "    if len(c_words) < 5:\n",
    "        return False, 'G1_corrected_too_short'\n",
    "    \n",
    "    # G2 — Length ratio\n",
    "    b_words = baseline.split()\n",
    "    if b_words:\n",
    "        ratio = len(c_words) / len(b_words)\n",
    "        if ratio < 0.35 or ratio > 3.5:\n",
    "            return False, f'G2_bad_length_ratio={ratio:.2f}'\n",
    "    \n",
    "    # G3 — Jaccard with baseline (not near-duplicate, not total rewrite)\n",
    "    jac_bc = token_jaccard(baseline, corrected)\n",
    "    if jac_bc > 0.82:\n",
    "        return False, f'G3_too_similar_to_baseline={jac_bc:.3f}'\n",
    "    if jac_bc < 0.08:\n",
    "        return False, f'G3_too_different_from_baseline={jac_bc:.3f}'\n",
    "    \n",
    "    # G4 — Question coverage\n",
    "    q_tok = set(normalize_text(question).split()) - STOPWORDS\n",
    "    c_tok = set(normalize_text(corrected).split())\n",
    "    q_cov = len(q_tok & c_tok) / len(q_tok) if q_tok else 1.0\n",
    "    if q_cov < 0.25:\n",
    "        return False, f'G4_low_question_coverage={q_cov:.3f}'\n",
    "    \n",
    "    # G5 — Knowledge-consistency improvement (proxy for 'correction improved')\n",
    "    jac_ck = token_jaccard(corrected, knowledge)\n",
    "    jac_bk = token_jaccard(baseline,  knowledge)\n",
    "    if jac_ck <= jac_bk + 0.02:\n",
    "        return False, (f'G5_no_knowledge_improvement'\n",
    "                       f'(corr={jac_ck:.3f} base={jac_bk:.3f})')\n",
    "    \n",
    "    # G6 — High-confidence signal (at least one signal >25% above threshold)\n",
    "    h_margin = signals['hidden']    - thresholds['hidden']\n",
    "    a_margin = signals['attention'] - thresholds['attention']\n",
    "    e_margin = signals['entropy']   - thresholds['entropy']\n",
    "    strong = sum([\n",
    "        h_margin > abs(thresholds['hidden'])    * 0.25,\n",
    "        a_margin > abs(thresholds['attention']) * 0.25,\n",
    "        e_margin > thresholds['entropy']        * 0.25,\n",
    "    ])\n",
    "    if strong < 1:\n",
    "        return False, f'G6_marginal_signal(h={h_margin:.2f},a={a_margin:.2f},e={e_margin:.2f})'\n",
    "    \n",
    "    # G7 — Repetition guard\n",
    "    if len(c_words) > 4:\n",
    "        bigrams = [f'{c_words[i]}_{c_words[i+1]}' for i in range(len(c_words)-1)]\n",
    "        top_bg_count = Counter(bigrams).most_common(1)[0][1]\n",
    "        if top_bg_count > max(3, len(bigrams) * 0.25):\n",
    "            return False, f'G7_repetition_detected(count={top_bg_count})'\n",
    "    \n",
    "    return True, 'accepted'\n",
    "\n",
    "print('Stronger accept/reject gate ready (7 guards).')\n"],
   "outputs": [],
   "execution_count": null
  },

   "cell_type": "code",
   "id": "cell-13-model-loader",
   "metadata": {"id": "cell-13-model-loader"},
   "source": ["# Cell 13 — Model loader and unloader\n",
    "from transformers import AutoTokenizer, AutoModelForCausalLM, BitsAndBytesConfig\n",
    "\n",
    "_BNB_CFG = BitsAndBytesConfig(\n",
    "    load_in_4bit=True,\n",
    "    bnb_4bit_compute_dtype=torch.float16,\n",
    "    bnb_4bit_quant_type='nf4',\n",
    "    bnb_4bit_use_double_quant=True,\n",
    ")\n",
    "\n",
    "def load_model(name):\n",
    "    cfg = MODEL_REGISTRY[name]\n",
    "    print(f'Loading {name} ({cfg[\"hf_id\"]})...')\n",
    "    tok = AutoTokenizer.from_pretrained(cfg['hf_id'])\n",
    "    tok.pad_token = tok.eos_token\n",
    "    kwargs = dict(device_map='auto', attn_implementation='eager')\n",
    "    if cfg['quantize']:\n",
    "        kwargs['quantization_config'] = _BNB_CFG\n",
    "    else:\n",
    "        kwargs['torch_dtype'] = torch.float16\n",
    "    mdl = AutoModelForCausalLM.from_pretrained(cfg['hf_id'], **kwargs)\n",
    "    mdl.eval()\n",
    "    print(f'  Loaded. VRAM used: {torch.cuda.memory_allocated()/1e9:.2f} GB')\n",
    "    return mdl, tok\n",
    "\n",
    "def unload_model(mdl):\n",
    "    del mdl\n",
    "    gc.collect()\n",
    "    torch.cuda.empty_cache()\n",
    "    print('  Model unloaded. VRAM cleared.')\n",
    "\n",
    "print('Model loader ready.')\n"],
   "outputs": [],
   "execution_count": null
  },

   "source": ["# Cell 16 — Write Streamlit app.py (4 pages: Overview, Per-Model, Per-Sample, Ablation)\n",
    "\n",
    "APP_CODE = '''\n",
    "import streamlit as st\n",
    "import json, os\n",

   "id": "cell-04-datasets",
   "metadata": {"id": "cell-04-datasets"},
   "source": ["# Cell 04 — Dataset loaders (all 5 datasets)\n",
    "from datasets import load_dataset\n",
    "\n",
    "def _sample(dataset, n, seed):\n",
    "    random.seed(seed)\n",
    "    idx = random.sample(range(len(dataset)), min(n, len(dataset)))\n",
    "    return dataset.select(idx)\n",
    "\n",
    "def load_pubmedqa(n=SAMPLE_SIZE):\n",
    "    ds = load_dataset('qiaojin/PubMedQA', 'pqa_labeled', split='train')\n",
    "    samples = _sample(ds, n, RANDOM_SEED)\n",
    "    return [{'question': r['question'], 'ground_truth': r['long_answer'],\n",
    "             'label': r['final_decision']} for r in samples]\n",
    "\n",
    "def load_mashqa(n=SAMPLE_SIZE):\n",
    "    try:\n",
    "        ds = load_dataset('zhengyun21/MASH-QA', split='train')\n",
    "    except Exception:\n",
    "        ds = load_dataset('zhengyun21/MASH-QA', split='test')\n",
    "    samples = _sample(ds, n, RANDOM_SEED)\n",
    "    out = []\n",
    "    for r in samples:\n",
    "        q = r.get('question', r.get('Question', ''))\n",
    "        a = r.get('answer', r.get('Answer', ''))\n",
    "        if isinstance(a, list):\n",
    "            a = ' '.join(a)\n",
    "        if q and a:\n",
    "            out.append({'question': q, 'ground_truth': a, 'label': None})\n",
    "    return out\n",
    "\n",
    "def load_finqa(n=SAMPLE_SIZE):\n",
    "    try:\n",
    "        ds = load_dataset('dreamerdeo/finqa', split='train')\n",
    "    except Exception:\n",
    "        ds = load_dataset('dreamerdeo/finqa', split='validation')\n",
    "    samples = _sample(ds, n, RANDOM_SEED)\n",
    "    out = []\n",
    "    for r in samples:\n",
    "        q = r.get('question', r.get('Question', ''))\n",
    "        a = r.get('answer', r.get('Answer', r.get('ground_truth', '')))\n",
    "        if isinstance(a, list):\n",
    "            a = str(a[0]) if a else ''\n",
    "        if q and a:\n",
    "            out.append({'question': q, 'ground_truth': str(a), 'label': None})\n",
    "    return out\n",
    "\n",
    "def load_medqa(n=SAMPLE_SIZE):\n",
    "    ds = load_dataset('bigbio/med_qa', 'med_qa_en_bigbio_qa', split='train')\n",
    "    samples = _sample(ds, n, RANDOM_SEED)\n",
    "    out = []\n",
    "    for r in samples:\n",
    "        q = r.get('question', '')\n",
    "        choices = r.get('choices', [])\n",
    "        key = r.get('answer_key', r.get('answer', ''))\n",
    "        if isinstance(key, list):\n",
    "            key = key[0] if key else ''\n",
    "        # Build ground truth as 'KEY: text'\n",
    "        gt = key\n",
    "        for c in choices:\n",
    "            if isinstance(c, dict) and c.get('key') == key:\n",
    "                gt = f\"{key}: {c.get('value', '')}\"\n",
    "                break\n",
    "        if q:\n",
    "            out.append({'question': q, 'ground_truth': gt,\n",
    "                         'choices': choices, 'label': key})\n",
    "    return out\n",
    "\n",
    "def load_triviaqa(n=SAMPLE_SIZE):\n",
    "    ds = load_dataset('trivia_qa', 'rc', split='train')\n",
    "    samples = _sample(ds, n, RANDOM_SEED)\n",
    "    out = []\n",
    "    for r in samples:\n",
    "        q = r.get('question', '')\n",
    "        ans = r.get('answer', {})\n",
    "        gt = ans.get('value', '') if isinstance(ans, dict) else str(ans)\n",
    "        aliases = ans.get('aliases', []) if isinstance(ans, dict) else []\n",
    "        if q and gt:\n",
    "            out.append({'question': q, 'ground_truth': gt,\n",
    "                         'aliases': aliases, 'label': None})\n",
    "    return out\n",
    "\n",
    "DATASET_LOADERS = {\n",
    "    'PubMedQA': load_pubmedqa,\n",
    "    'MASH-QA':  load_mashqa,\n",
    "    'FinQA':    load_finqa,\n",
    "    'MedQA':    load_medqa,\n",
    "    'TriviaQA': load_triviaqa,\n",
    "}\n",
    "print('Dataset loaders ready:', list(DATASET_LOADERS.keys()))\n"],

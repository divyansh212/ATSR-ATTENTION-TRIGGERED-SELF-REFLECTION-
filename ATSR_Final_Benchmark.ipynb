   "cell_type": "code",
   "id": "cell-15-results",
   "metadata": {"id": "cell-15-results"},
   "source": ["# Cell 15 — Results aggregation and visualization\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.gridspec as gridspec\n",
    "import seaborn as sns\n",
    "\n",
    "COLOR_BG, COLOR_TEXT, COLOR_GRID = '#0F1117', '#E8E8E8', '#2A2D35'\n",
    "C_BEFORE, C_AFTER, C_TRIGGER, C_ACCEPT = '#E24B4A', '#1D9E75', '#378ADD', '#F5A623'\n",
    "\n",
    "plt.rcParams.update({\n",
    "    'font.family': 'monospace', 'text.color': COLOR_TEXT,\n",
    "    'axes.labelcolor': COLOR_TEXT, 'xtick.color': COLOR_TEXT,\n",
    "    'ytick.color': COLOR_TEXT, 'figure.facecolor': COLOR_BG,\n",
    "    'axes.facecolor': COLOR_BG, 'axes.edgecolor': COLOR_GRID,\n",
    "    'grid.color': COLOR_GRID,\n",
    "})\n",
    "\n",
    "def print_summary_table(results):\n",
    "    print('\\n' + '='*80)\n",
    "    print('  ATSR BENCHMARK SUMMARY')\n",
    "    print('='*80)\n",
    "    hdr = f\"  {'Model':<16} {'Dataset':<12} {'F1 Before':>10} {'F1 After':>10} {'Δ F1':>8} {'Trigger':>8} {'Accept':>8} {'AUROC':>7}\"\n",
    "    print(hdr)\n",
    "    print('-'*80)\n",
    "    for model_name, ds_dict in results.items():\n",
    "        for ds_name, r in ds_dict.items():\n",
    "            delta  = r['improvement']\n",
    "            arrow  = '↑' if delta > 1e-4 else ('↓' if delta < -1e-4 else '=')\n",
    "            auroc  = f\"{r['auroc']:.3f}\" if r.get('auroc') else 'N/A'\n",

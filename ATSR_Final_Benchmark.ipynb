    "@st.cache_data(ttl=30)\n",
    "def load_results():\n",
    "    if not os.path.exists(RESULTS_FILE):\n",
    "        return {}\n",
    "    with open(RESULTS_FILE) as f:\n",
    "        return json.load(f)\n",
    "\n",
    "results = load_results()\n",
    "\n",
    "PAGE = st.sidebar.radio('Page', [\n",
    "    '\u{1f4ca} Overview',\n",
    "    '\u{1f916} Per-Model Deep Dive',\n",
    "    '\u{1f50d} Per-Sample Inspector',\n",
    "    '\u{1f9ea} Ablation: Gate Conditions',\n",
    "])\n",
    "\n",
    "# ────────────────────────────────────────────────────────────────────────\n",
    "if PAGE == '\u{1f4ca} Overview':\n",
    "    st.title('\u{1f9e0} ATSR Hallucination Detection — Benchmark Overview')\n",
    "    if not results:\n",
    "        st.warning('No results found. Run the benchmark first.')\n",
    "        st.stop()\n",
    "    rows = []\n",
    "    for model, ds_dict in results.items():\n",
    "        for ds, r in ds_dict.items():\n",
    "            rows.append({\n",
    "                'Model': model, 'Dataset': ds,\n",
    "                'F1 Before': round(r['f1_before'], 4),\n",
    "                'F1 After':  round(r['f1_after'],  4),\n",
    "                'Δ F1':      round(r['improvement'], 4),\n",
    "                'Trigger%':  round(r['trigger_rate']*100, 1),\n",
    "                'Accept%':   round(r['accept_rate']*100, 1),\n",
    "                'AUROC':     round(r['auroc'], 3) if r.get('auroc') else None,\n",
    "                'TPR@5FPR':  round(r['tpr_at_5fpr'], 3) if r.get('tpr_at_5fpr') else None,\n",
    "                'Runtime(m)':round(r['runtime_min'], 1),\n",
    "            })\n",
    "    df = pd.DataFrame(rows)\n",
    "    def color_delta(v):\n",
    "        c = 'background-color:#1a4a2e' if v > 0 else ('background-color:#4a1a1a' if v < 0 else '')\n",
    "        return c\n",
    "    st.dataframe(df.style.applymap(color_delta, subset=['Δ F1']), use_container_width=True)\n",
    "    st.subheader('Average improvement by model')\n",
    "    avg = df.groupby('Model')['Δ F1'].mean().reset_index()\n",
    "    st.bar_chart(avg.set_index('Model'))\n",
    "\n",
    "# ────────────────────────────────────────────────────────────────────────\n",
    "elif PAGE == '\u{1f916} Per-Model Deep Dive':\n",
    "    st.title('\u{1f916} Per-Model Deep Dive')\n",
    "    if not results:\n",
    "        st.warning('No results yet.'); st.stop()\n",
    "    model = st.selectbox('Select model', list(results.keys()))\n",
    "    ds_dict = results[model]\n",
    "    cols = st.columns(len(ds_dict))\n",
    "    for i, (ds, r) in enumerate(ds_dict.items()):\n",
    "        with cols[i]:\n",
    "            delta = r['improvement']\n",
    "            color = '\u{1f7e2}' if delta > 0 else ('\u{1f534}' if delta < 0 else '⚪')\n",
    "            st.metric(f'{color} {ds}', f\"{r['f1_after']:.4f}\",\n",
    "                      delta=f\"{delta:+.4f}\")\n",
    "            st.caption(f\"Trigger {r['trigger_rate']:.1%} | Accept {r['accept_rate']:.1%}\")\n",
    "            if r.get('auroc'):\n",
    "                st.caption(f\"AUROC {r['auroc']:.3f} | TPR@5FPR {r['tpr_at_5fpr']:.3f}\")\n",
    "    st.subheader('F1 Before vs After')\n",
    "    df2 = pd.DataFrame([\n",
    "        {'Dataset': ds, 'Before': r['f1_before'], 'After': r['f1_after']}\n",
    "        for ds, r in ds_dict.items()\n",
    "    ])\n",
    "    st.bar_chart(df2.set_index('Dataset'))\n",
    "\n",
    "# ────────────────────────────────────────────────────────────────────────\n",
    "elif PAGE == '\u{1f50d} Per-Sample Inspector':\n",
    "    st.title('\u{1f50d} Per-Sample Inspector')\n",
    "    if not results:\n",
    "        st.warning('No results yet.'); st.stop()\n",
    "    model   = st.selectbox('Model',   list(results.keys()))\n",
    "    dataset = st.selectbox('Dataset', list(results[model].keys()))\n",
    "    samples = results[model][dataset].get('per_sample', [])\n",
    "    valid   = [s for s in samples if 'error' not in s]\n",
    "    if not valid:\n",
    "        st.warning('No valid samples.'); st.stop()\n",
    "    sort_by = st.radio('Sort by', ['Improvement ↓', 'Regression ↓', 'Triggered only'])\n",
    "    if sort_by == 'Improvement ↓':\n",

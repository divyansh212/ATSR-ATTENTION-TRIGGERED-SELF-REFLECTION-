   "id": "cell-05-metrics",
   "metadata": {"id": "cell-05-metrics"},
   "source": ["# Cell 05 — Metric functions: F1, AUROC, TPR@FPR=5%\n",
    "from sklearn.metrics import roc_auc_score, roc_curve\n",
    "\n",
    "def normalize_text(text):\n",
    "    text = str(text).lower()\n",
    "    text = re.sub(r'[^a-z0-9\\s]', ' ', text)\n",
    "    return re.sub(r'\\s+', ' ', text).strip()\n",
    "\n",
    "def compute_f1(prediction, ground_truth):\n",
    "    pred_tok  = normalize_text(prediction).split()\n",
    "    truth_tok = normalize_text(ground_truth).split()\n",
    "    if not pred_tok or not truth_tok:\n",
    "        return 0.0\n",
    "    pc = Counter(pred_tok); tc = Counter(truth_tok)\n",
    "    overlap = sum((pc & tc).values())\n",
    "    if overlap == 0:\n",
    "        return 0.0\n",
    "    p = overlap / len(pred_tok)\n",
    "    r = overlap / len(truth_tok)\n",
    "    return 2 * p * r / (p + r)\n",
    "\n",
    "def compute_f1_with_aliases(prediction, sample):\n",
    "    gt = sample['ground_truth']\n",
    "    best = compute_f1(prediction, gt)\n",
    "    for alias in sample.get('aliases', []):\n",
    "        best = max(best, compute_f1(prediction, alias))\n",
    "    return best\n",
    "\n",
    "def token_jaccard(text_a, text_b):\n",
    "    a = set(normalize_text(text_a).split()) - STOPWORDS\n",
    "    b = set(normalize_text(text_b).split()) - STOPWORDS\n",
    "    if not a or not b:\n",
    "        return 0.0\n",
    "    return len(a & b) / len(a | b)\n",
    "\n",
    "def compute_detection_metrics(per_sample_results):\n",
    "    triggered = [r for r in per_sample_results\n",
    "                 if 'error' not in r and r.get('triggered', False)]\n",
    "    if len(triggered) < 10:\n",
    "        return {'auroc': None, 'tpr_at_5fpr': None}\n",
    "    scores = np.array([r['signals']['entropy'] for r in triggered])\n",
    "    labels = np.array([int(r['f1_final'] > r['f1_baseline'] + 1e-4)\n",
    "                       for r in triggered])\n",
    "    if labels.sum() == 0 or labels.sum() == len(labels):\n",
    "        return {'auroc': None, 'tpr_at_5fpr': None}\n",
    "    auroc = float(roc_auc_score(labels, scores))\n",
    "    fpr_arr, tpr_arr, _ = roc_curve(labels, scores)\n",
    "    idx = int(np.searchsorted(fpr_arr, 0.05))\n",
    "    tpr5 = float(tpr_arr[min(idx, len(tpr_arr)-1)])\n",
    "    return {'auroc': auroc, 'tpr_at_5fpr': tpr5}\n",
    "\n",
    "print('Metric functions ready.')\n"],
   "outputs": [],
   "execution_count": null
  },

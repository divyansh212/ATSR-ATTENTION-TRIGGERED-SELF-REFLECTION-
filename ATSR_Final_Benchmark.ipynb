    "    st.markdown(f\"**Question:** {r['question']}\")\n",
    "    c1, c2 = st.columns(2)\n",
    "    with c1:\n",
    "        st.markdown('**Baseline answer**')\n",
    "        st.info(r.get('baseline',''))\n",
    "        st.metric('F1 baseline', f\"{r['f1_baseline']:.4f}\")\n",
    "    with c2:\n",
    "        label = '**Final answer (accepted)**' if r.get('accepted') else '**Final = Baseline (gate rejected)**'\n",
    "        st.markdown(label)\n",
    "        st.success(r.get('final', r.get('baseline','')))\n",
    "        delta = r['f1_final'] - r['f1_baseline']\n",
    "        st.metric('F1 final', f\"{r['f1_final']:.4f}\", delta=f\"{delta:+.4f}\")\n",
    "    st.caption(f\"Triggered={r.get('triggered')} | Accepted={r.get('accepted')} | Gate: {r.get('gate_reason','')}\")\n",
    "    if r.get('signals'):\n",
    "        st.json(r['signals'])\n",
    "\n",
    "# ────────────────────────────────────────────────────────────────────────\n",
    "elif PAGE == '\u{1f9ea} Ablation: Gate Conditions':\n",
    "    st.title('\u{1f9ea} Ablation: Gate Condition Analysis')\n",
    "    if not results:\n",
    "        st.warning('No results yet.'); st.stop()\n",
    "    model   = st.selectbox('Model',   list(results.keys()))\n",
    "    dataset = st.selectbox('Dataset', list(results[model].keys()))\n",
    "    samples = [s for s in results[model][dataset].get('per_sample', [])\n",
    "               if 'error' not in s and s.get('triggered')]\n",
    "    if not samples:\n",
    "        st.warning('No triggered samples.'); st.stop()\n",
    "    reasons = [s.get('gate_reason','') for s in samples]\n",
    "    from collections import Counter\n",
    "    counts  = Counter(reasons)\n",
    "    df_gate = pd.DataFrame(counts.items(), columns=['Gate Reason', 'Count'])\n",
    "    df_gate = df_gate.sort_values('Count', ascending=False)\n",
    "    st.subheader('Why corrections were rejected/accepted')\n",
    "    st.bar_chart(df_gate.set_index('Gate Reason'))\n",
    "    st.dataframe(df_gate, use_container_width=True)\n",
    "    accepted  = [s for s in samples if s.get('accepted')]\n",
    "    rejected  = [s for s in samples if not s.get('accepted')]\n",
    "    st.subheader('F1 delta: accepted vs rejected')\n",
    "    col1, col2 = st.columns(2)\n",
    "    if accepted:\n",
    "        acc_deltas = [s['f1_final'] - s['f1_baseline'] for s in accepted]\n",
    "        col1.metric('Accepted (mean Δ F1)', f'{np.mean(acc_deltas):+.4f}',\n",
    "                    delta=f'{len(accepted)} samples')\n",
    "    if rejected:\n",
    "        rej_corr_deltas = [s['f1_corrected'] - s['f1_baseline']\n",
    "                           for s in rejected if 'f1_corrected' in s]\n",
    "        if rej_corr_deltas:\n",
    "            col2.metric('Rejected corrections (mean Δ F1 if applied)',\n",
    "                        f'{np.mean(rej_corr_deltas):+.4f}',\n",
    "                        delta=f'{len(rejected)} samples (gate saved these)')\n",
    "'''\n",
    "\n",
    "with open('/content/app.py', 'w') as f:\n",
    "    f.write(APP_CODE.strip())\n",
    "print('app.py written to /content/app.py')\n"],

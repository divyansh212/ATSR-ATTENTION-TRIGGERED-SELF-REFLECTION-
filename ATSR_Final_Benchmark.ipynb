    "    elif sort_by == 'Regression ↓':\n",
    "        valid = sorted(valid, key=lambda r: r['f1_final'] - r['f1_baseline'])\n",
    "    else:\n",
    "        valid = [r for r in valid if r.get('triggered')]\n",
    "    idx = st.slider('Sample index', 0, len(valid)-1, 0)\n",

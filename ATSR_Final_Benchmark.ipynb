   "cell_type": "code",
   "id": "cell-14-benchmark",
   "metadata": {"id": "cell-14-benchmark"},
   "source": ["# Cell 14 — Benchmark runner with per-dataset incremental JSON saving\n",
    "from tqdm.auto import tqdm\n",
    "import datetime\n",
    "\n",
    "def load_or_init_results():\n",
    "    if os.path.exists(RESULTS_FILE):\n",
    "        with open(RESULTS_FILE) as f:\n",
    "            return json.load(f)\n",
    "    return {}\n",
    "\n",
    "def save_results(results):\n",
    "    os.makedirs(os.path.dirname(RESULTS_FILE), exist_ok=True)\n",
    "    with open(RESULTS_FILE, 'w') as f:\n",
    "        json.dump(results, f, indent=2, default=str)\n",
    "    print(f'  Saved → {RESULTS_FILE}')\n",
    "\n",
    "def run_dataset(model_name, dataset_name, model, tokenizer, all_results):\n",
    "    cfg     = MODEL_REGISTRY[model_name]\n",
    "    layers  = cfg['layers']\n",
    "    domain  = DATASET_REGISTRY[dataset_name]['domain']\n",
    "    \n",
    "    # Skip if already done\n",
    "    if model_name in all_results and dataset_name in all_results[model_name]:\n",
    "        print(f'  [{dataset_name}] Already in results — skipping.')\n",
    "        return all_results\n",
    "    \n",
    "    print(f'  Loading {dataset_name}...')\n",
    "    samples = DATASET_LOADERS[dataset_name](SAMPLE_SIZE)\n",
    "    print(f'  Loaded {len(samples)} samples.')\n",
    "    \n",
    "    # Calibrate thresholds on 20% probe split\n",
    "    n_probe  = max(10, len(samples) // 5)\n",
    "    probes   = random.sample(samples, n_probe)\n",
    "    thresholds = calibrate_thresholds(probes, model, tokenizer, layers)\n",
    "    \n",
    "    per_sample = []\n",
    "    t0 = time.time()\n",
    "    \n",
    "    for i, sample in enumerate(tqdm(samples, desc=f'{model_name}/{dataset_name}')):\n",
    "        try:\n",
    "            result = atsr_pipeline(sample, model, tokenizer, layers, thresholds, domain)\n",
    "            per_sample.append(result)\n",
    "        except Exception as e:\n",
    "            traceback.print_exc()\n",
    "            per_sample.append({'error': str(e), 'question': sample.get('question','')})\n",
    "        \n",
    "        if i == 0 and per_sample and 'error' not in per_sample[0]:\n",
    "            r = per_sample[0]\n",
    "            print(f'  Sample 0 OK — F1 base={r[\"f1_baseline\"]:.3f} '\n",
    "                  f'final={r[\"f1_final\"]:.3f} triggered={r[\"triggered\"]} '\n",
    "                  f'accepted={r[\"accepted\"]}')\n",
    "    \n",
    "    runtime = (time.time() - t0) / 60\n",
    "    valid   = [r for r in per_sample if 'error' not in r]\n",
    "    errors  = len(per_sample) - len(valid)\n",
    "    \n",
    "    if not valid:\n",
    "        print(f'  !! All samples failed for {dataset_name}')\n",
    "        return all_results\n",
    "    \n",
    "    avg_f1_base  = float(np.mean([r['f1_baseline'] for r in valid]))\n",
    "    avg_f1_final = float(np.mean([r['f1_final']    for r in valid]))\n",
    "    trigger_rate = float(np.mean([r['triggered']   for r in valid]))\n",
    "    accept_rate  = float(np.mean([r['accepted']    for r in valid]))\n",
    "    det_metrics  = compute_detection_metrics(valid)\n",
    "    \n",
    "    print(f'  {dataset_name}: F1 {avg_f1_base:.4f} → {avg_f1_final:.4f} '\n",
    "          f'(Δ{avg_f1_final-avg_f1_base:+.4f}) | '\n",
    "          f'trigger={trigger_rate:.1%} accept={accept_rate:.1%} | '\n",
    "          f'AUROC={det_metrics[\"auroc\"]} TPR@5FPR={det_metrics[\"tpr_at_5fpr\"]} | '\n",
    "          f'errors={errors} runtime={runtime:.1f}min')\n",
    "    \n",
    "    entry = {\n",
    "        'f1_before':    avg_f1_base,\n",
    "        'f1_after':     avg_f1_final,\n",
    "        'improvement':  avg_f1_final - avg_f1_base,\n",
    "        'trigger_rate': trigger_rate,\n",
    "        'accept_rate':  accept_rate,\n",
    "        'auroc':        det_metrics['auroc'],\n",
    "        'tpr_at_5fpr':  det_metrics['tpr_at_5fpr'],\n",
    "        'errors':       errors,\n",
    "        'runtime_min':  runtime,\n",
    "        'sample_size':  len(valid),\n",
    "        'thresholds':   thresholds,\n",
    "        'domain':       domain,\n",
    "        'timestamp':    datetime.datetime.now().isoformat(),\n",
    "        'per_sample':   [{k: v for k, v in r.items() if k not in ('knowledge',)}\n",
    "                         for r in valid],   # omit knowledge to keep file compact\n",
    "    }\n",
    "    \n",
    "    all_results.setdefault(model_name, {})[dataset_name] = entry\n",
    "    save_results(all_results)   # incremental save after every dataset\n",
    "    return all_results\n",
    "\n",
    "\n",
    "# ── Main entry point ────────────────────────────────────────────────────\n",
    "# Mount Google Drive first so RESULTS_FILE path is accessible\n",
    "from google.colab import drive\n",
    "drive.mount('/content/drive')\n",
    "\n",
    "all_results = load_or_init_results()\n",
    "print(f'Loaded existing results for: {list(all_results.keys())}')\n",
    "\n",
    "model, tokenizer = load_model(ACTIVE_MODEL)\n",
    "\n",
    "for ds_name in DATASET_REGISTRY:\n",
    "    all_results = run_dataset(ACTIVE_MODEL, ds_name, model, tokenizer, all_results)\n",
    "\n",
    "unload_model(model)\n",
    "print('\\nAll datasets complete for', ACTIVE_MODEL)\n"],
   "outputs": [],

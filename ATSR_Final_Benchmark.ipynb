   "cell_type": "code",
   "id": "cell-10-loops",
   "metadata": {"id": "cell-10-loops"},
   "source": ["# Cell 10 — Self-reflection loops (generation, loop1 knowledge, loop2 correction, loop3 check)\n",
    "\n",
    "def generate_text(prompt, model, tokenizer, max_new_tokens=MAX_NEW_TOKENS):\n",
    "    inputs = tokenizer(prompt, return_tensors='pt', truncation=True,\n",
    "                       max_length=768).to(model.device)\n",
    "    with torch.no_grad():\n",
    "        ids = model.generate(\n",
    "            **inputs, max_new_tokens=max_new_tokens, do_sample=False,\n",
    "            temperature=1.0, pad_token_id=tokenizer.eos_token_id,\n",
    "        )\n",
    "    new_ids = ids[0][inputs['input_ids'].shape[1]:]\n",
    "    return tokenizer.decode(new_ids, skip_special_tokens=True).strip()\n",
    "\n",
    "def loop1_knowledge(question, flagged, model, tokenizer, domain, max_iter=2):\n",
    "    \"\"\"Generate verified factual background (Loop 1).\"\"\"\n",
    "    prompt   = get_knowledge_prompt(question, flagged, domain)\n",
    "    best_out = ''\n",
    "    for _ in range(max_iter):\n",
    "        out = generate_text(prompt, model, tokenizer, max_new_tokens=100)\n",
    "        if len(out.split()) > 10:\n",
    "            best_out = out\n",
    "            break\n",
    "    return best_out\n",
    "\n",
    "def loop2_correction(question, knowledge, flagged, model, tokenizer, domain,\n",
    "                     choices=None, max_iter=2):\n",
    "    \"\"\"Generate knowledge-grounded corrected answer (Loop 2).\"\"\"\n",
    "    prompt   = get_correction_prompt(question, knowledge, flagged, domain, choices)\n",
    "    best_out = ''\n",
    "    for _ in range(max_iter):\n",
    "        out = generate_text(prompt, model, tokenizer)\n",
    "        k_words = set(normalize_text(knowledge).split())\n",
    "        a_words = set(normalize_text(out).split())\n",
    "        if k_words and len(a_words & k_words) / len(k_words) > 0.05:\n",
    "            best_out = out\n",
    "            break\n",
    "        if not best_out:\n",
    "            best_out = out\n",
    "    return best_out\n",
    "\n",
    "def loop3_coverage_check(question, answer):\n",
    "    \"\"\"Check that answer covers key content words from the question.\"\"\"\n",
    "    q_words = set(normalize_text(question).split()) - STOPWORDS\n",
    "    a_words = set(normalize_text(answer).split())\n",
    "    if not q_words:\n",
    "        return True\n",
    "    return len(q_words & a_words) / len(q_words) >= 0.25\n",
    "\n",
    "print('Self-reflection loops ready.')\n"],
   "outputs": [],
   "execution_count": null
  },

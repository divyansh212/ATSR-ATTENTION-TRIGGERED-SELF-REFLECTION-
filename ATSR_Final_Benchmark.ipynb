   "cell_type": "code",
   "id": "cell-08-localization",
   "metadata": {"id": "cell-08-localization"},
   "source": ["# Cell 08 — Token localization (identify suspicious tokens)\n",
    "\n",
    "def localize_hallucinated_tokens(outputs, tokenizer, inputs, top_n=5):\n",
    "    mid = len(outputs.attentions) // 2\n",
    "    attn = outputs.attentions[mid][0].float()   # (heads, seq, seq)\n",
    "    diag_scores = torch.stack([\n",
    "        torch.diagonal(attn[h]) for h in range(attn.shape[0])\n",
    "    ]).mean(dim=0)\n",
    "    k = min(top_n, diag_scores.shape[0])\n",
    "    top_ids   = diag_scores.topk(k).indices\n",
    "    token_ids = inputs['input_ids'][0][top_ids]\n",
    "    tokens    = tokenizer.convert_ids_to_tokens(token_ids)\n",
    "    tokens    = [t.replace('▁', '').replace('Ġ', '').strip() for t in tokens if t]\n",
    "    tokens    = [t for t in tokens if len(t) > 2]\n",
    "    return tokens[:top_n]\n",
    "\n",
    "print('Token localization ready.')\n"],
   "outputs": [],
   "execution_count": null
  },

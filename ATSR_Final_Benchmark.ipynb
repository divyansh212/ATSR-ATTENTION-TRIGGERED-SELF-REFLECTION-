   "cell_type": "code",
   "id": "cell-12-pipeline",
   "metadata": {"id": "cell-12-pipeline"},
   "source": ["# Cell 12 — Full ATSR pipeline integrating all components\n",
    "\n",
    "def atsr_pipeline(sample, model, tokenizer, layers, thresholds, domain):\n",
    "    \"\"\"\n",
    "    Run ATSR for one sample.\n",
    "    Returns result dict with all fields for metrics computation.\n",
    "    'final' field is what we score — equals corrected only if gate accepts,\n",
    "    otherwise equals baseline, guaranteeing no per-sample regression.\n",
    "    \"\"\"\n",
    "    question  = sample['question']\n",
    "    gt        = sample['ground_truth']\n",
    "    choices   = sample.get('choices', None)\n",
    "    \n",
    "    # Stage 1 — Baseline generation\n",
    "    base_prompt = get_baseline_prompt(question, domain, choices)\n",
    "    baseline    = generate_text(base_prompt, model, tokenizer)\n",
    "    f1_base     = compute_f1_with_aliases(baseline, sample)\n",
    "    \n",
    "    # Stage 2 — Activation analysis (teacher-forcing with baseline answer)\n",
    "    outputs, inputs = teacher_forcing_pass(question, baseline, model, tokenizer)\n",
    "    signals  = compute_signals(outputs, layers)\n",
    "    triggered, n_fired = majority_vote(signals, thresholds)\n",
    "    \n",
    "    if not triggered:\n",
    "        return {\n",
    "            'question': question, 'ground_truth': gt,\n",
    "            'baseline': baseline, 'corrected': baseline, 'final': baseline,\n",
    "            'f1_baseline': f1_base, 'f1_corrected': f1_base, 'f1_final': f1_base,\n",
    "            'triggered': False, 'accepted': False, 'gate_reason': 'not_triggered',\n",
    "            'signals': signals, 'n_fired': n_fired, 'knowledge': '', 'flagged': [],\n",
    "        }\n",
    "    \n",
    "    # Stage 3 — Token localization\n",
    "    flagged = localize_hallucinated_tokens(outputs, tokenizer, inputs)\n",
    "    \n",
    "    # Stage 4 — Self-reflection loops\n",
    "    knowledge = loop1_knowledge(question, flagged, model, tokenizer, domain)\n",
    "    corrected = loop2_correction(question, knowledge, flagged, model, tokenizer,\n",
    "                                  domain, choices)\n",
    "    \n",
    "    # Stage 5 — Loop 3 coverage check\n",
    "    if not loop3_coverage_check(question, corrected):\n",
    "        return {\n",
    "            'question': question, 'ground_truth': gt,\n",
    "            'baseline': baseline, 'corrected': corrected, 'final': baseline,\n",
    "            'f1_baseline': f1_base,\n",
    "            'f1_corrected': compute_f1_with_aliases(corrected, sample),\n",
    "            'f1_final': f1_base,\n",
    "            'triggered': True, 'accepted': False, 'gate_reason': 'loop3_failed',\n",
    "            'signals': signals, 'n_fired': n_fired, 'knowledge': knowledge, 'flagged': flagged,\n",
    "        }\n",
    "    \n",
    "    # Stage 6 — Stronger accept/reject gate\n",
    "    accepted, gate_reason = accept_correction(\n",
    "        baseline, corrected, question, knowledge, signals, thresholds\n",
    "    )\n",
    "    final       = corrected if accepted else baseline\n",
    "    f1_corrected = compute_f1_with_aliases(corrected, sample)\n",
    "    f1_final     = compute_f1_with_aliases(final, sample)\n",
    "    \n",
    "    return {\n",
    "        'question': question, 'ground_truth': gt,\n",
    "        'baseline': baseline, 'corrected': corrected, 'final': final,\n",
    "        'f1_baseline': f1_base, 'f1_corrected': f1_corrected, 'f1_final': f1_final,\n",
    "        'triggered': True, 'accepted': accepted, 'gate_reason': gate_reason,\n",
    "        'signals': signals, 'n_fired': n_fired,\n",
    "        'knowledge': knowledge, 'flagged': flagged,\n",
    "    }\n",
    "\n",
    "print('ATSR pipeline ready.')\n"],
   "outputs": [],
   "execution_count": null
  },
